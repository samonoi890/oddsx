# --- OddsX seed script (packages/scripts) ---

# REQUIRED: private key of an account that holds MARKET_CREATOR_ROLE on the
# contract. With or without the 0x prefix. NEVER commit a funded key.
ADMIN_PRIVATE_KEY=0xYOUR_ADMIN_PRIVATE_KEY

# OPTIONAL overrides (sensible defaults are used if omitted)
# Target contract (defaults to the address you are seeding)
ODDSX_ADDRESS=0xeaE8F58DF7a3db3A3268BbE056E01AB3703b27c2
# Arc Testnet RPC endpoint
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Designated on-chain oracle/resolver for the created markets
# (defaults to the admin account derived from ADMIN_PRIVATE_KEY)
ORACLE_ADDRESS=
# Settlement asset: leave empty / zero address for native USDC, or an ERC-20 address
SETTLEMENT_ASSET=0x0000000000000000000000000000000000000000
