# OddsX web application (safe to expose in the browser)
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ODDSX_ADDRESS_ARC_TESTNET=0x6C9fD55355e83190363842693867826d4eCd94C5
# Optional: enables WalletConnect QR and mobile deep-link connections.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_REOWN_PROJECT_ID

# Foundry deployment credential (replace locally; never commit a funded key)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Optional: assign protocol roles to a multisig instead of the broadcasting EOA.
ODDSX_ADMIN=0xYOUR_ADMIN_OR_MULTISIG_ADDRESS
# Optional: delay resolution for newly created markets (seconds, maximum 604800).
ODDSX_RESOLUTION_DELAY=0

# Optional Foundry networks and contract verification
SEPOLIA_RPC_URL=https://sepolia.example.invalid
MAINNET_RPC_URL=https://mainnet.example.invalid
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
